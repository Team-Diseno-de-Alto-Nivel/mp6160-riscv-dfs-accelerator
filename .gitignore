# Build artifacts
build/
build-native/

# Experiment outputs (generated by scripts/run_experiments.sh + plot_results.py)
# -- results/* (not results/) so the negations below can re-include specific
# nested files; a plain "results/" would exclude the directory itself and no
# negation could see inside it (see gitignore(5), NOTES).
results/*

# ... except the on-board CSV (issue #91) and the cost-model correlation it
# feeds (issue #92): those depend on KV260 access, which not everyone on the
# team has, so — same reasoning as dfs_accel_prj/ above — they're versioned
# explicitly instead of staying gitignored like the rest of results/.
!results/onboard_metrics.csv
!results/tables
results/tables/*
!results/tables/cost_model_correlation.md
!results/tables/cost_model_correlation.tex

# Demo recording artifacts (generated by scripts/demo.sh + .github/workflows/demo.yml)
demo.cast
demo.gif
demo.mp4
*.o
*.a
*.so
*.out

# Python bytecode cache (e.g. from local syntax checks on src/pynq/*.py)
__pycache__/
*.pyc

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile.cmake
_deps/

# Vitis HLS generated project (issues #63, #95) — only logs/vitis_hls.log
# is versioned, so the team can see results without installing Vitis.
dfs_accel_prj/
.Xil/
*.jou

# Vivado generated project (issue #64) — only the scripts under
# src/vivado/scripts/ are versioned, so the team can see the design without
# installing Vivado.
src/vivado/dfs_system/

# Vivado batch-mode backup logs (issue #66) — Vivado renames the previous
# vivado.log to vivado_<PID>.backup.log every time a new batch session
# starts in the same directory. logs/vivado.log itself IS versioned (see
# logs/), only these throwaway backups are ignored.
vivado_*.backup.log

# macOS
.DS_Store
.AppleDouble

# Editor
.vscode/*
!.vscode/c_cpp_properties.json
*.swp
*~
